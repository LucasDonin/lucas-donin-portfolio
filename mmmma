session_start();

// Login / logout
if (isset($_POST['logout'])) {
    session_destroy();
    header('Location: admin.php');
    exit;
}

if (isset($_POST['password'])) {
    if ($_POST['password'] === ADMIN_PASSWORD) {
        $_SESSION['admin'] = true;
    } else {
        $loginError = 'Senha incorreta.';
    }
}

$loggedIn = !empty($_SESSION['admin']);

// Ações do painel
if ($loggedIn) {
    $pdo = getDB();

    // Confirmar pedido
    if (isset($_POST['confirm_order'])) {
        $id = (int)$_POST['confirm_order'];
        $pdo->prepare("UPDATE orders SET status='confirmed', confirmed_at=CURRENT_TIMESTAMP WHERE id=?")->execute([$id]);
    }

    // Cancelar pedido (devolve ao estoque)
    if (isset($_POST['cancel_order'])) {
        $id = (int)$_POST['cancel_order'];
        $stmt = $pdo->prepare("SELECT status FROM orders WHERE id=?");
        $stmt->execute([$id]);
        $order = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($order && $order['status'] !== 'cancelled') {
            $pdo->prepare("UPDATE orders SET status='cancelled' WHERE id=?")->execute([$id]);
            incrementStock();
        }
    }

    // Editar estoque manualmente
    if (isset($_POST['set_stock'])) {
        $newStock = max(0, min(STOCK_TOTAL, (int)$_POST['set_stock']));
        $pdo->exec("UPDATE stock SET available = $newStock WHERE id = 1");
    }

    // Adicionar nota a um pedido
    if (isset($_POST['save_note'])) {
        $id = (int)$_POST['note_order_id'];
        $note = trim($_POST['note'] ?? '');
        $pdo->prepare("UPDATE orders SET notes=? WHERE id=?")->execute([$note, $id]);
    }

    // Buscar dados
    $stock = getStock();
    $filter = $_GET['filter'] ?? 'all';
    $search = trim($_GET['q'] ?? '');

    $where = '';
    $params = [];

    if ($filter === 'confirmed') { $where = "WHERE status='confirmed'"; }
    elseif ($filter === 'pending') { $where = "WHERE status='pending'"; }
    elseif ($filter === 'cancelled') { $where = "WHERE status='cancelled'"; }

    if ($search) {
        $like = "%$search%";
        $searchClause = "name LIKE ? OR email LIKE ? OR phone LIKE ?";
        $where = $where ? "$where AND ($searchClause)" : "WHERE $searchClause";
        $params = array_merge($params, [$like, $like, $like]);
    }

    $orders = $pdo->prepare("SELECT * FROM orders $where ORDER BY created_at DESC");
    $orders->execute($params);
    $orders = $orders->fetchAll(PDO::FETCH_ASSOC);

    // Totais
    $totals = $pdo->query("SELECT status, COUNT(*) as cnt FROM orders GROUP BY status")->fetchAll(PDO::FETCH_ASSOC);
    $totalMap = array_column($totals, 'cnt', 'status');
}

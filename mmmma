require_once __DIR__ . '/config.php';
require_once __DIR__ . '/db.php';

$stock = getStock();
if ($stock <= 0) {
    header('Location: index.php?esgotado=1');
    exit;
}

$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $name           = trim($_POST['name'] ?? '');
    $email          = trim($_POST['email'] ?? '');
    $phone          = trim($_POST['phone'] ?? '');
    $size           = trim($_POST['size'] ?? '');
    $wantsSignature = !empty($_POST['wants_signature']);

    $validSizes = SIZES;

    if (empty($name) || strlen($name) < 3) {
        $error = 'Por favor, informe seu nome completo.';
    } elseif (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $error = 'Por favor, informe um e-mail válido.';
    } elseif (empty($phone) || strlen(preg_replace('/\D/', '', $phone)) < 10) {
        $error = 'Por favor, informe um telefone válido com DDD.';
    } elseif (!in_array($size, $validSizes)) {
        $error = 'Por favor, selecione um tamanho.';
    } else {
        $currentStock = getStock();
        if ($currentStock <= 0) {
            header('Location: index.php?esgotado=1');
            exit;
        }

        $nota = $wantsSignature ? '✍️ QUER ASSINATURA DO MOICANO' : '';

        $pdo  = getDB();
        $stmt = $pdo->prepare("INSERT INTO orders (name, email, phone, size, status, notes) VALUES (?, ?, ?, ?, 'pending', ?)");
        $stmt->execute([$name, $email, $phone, $size, $nota]);
        $orderId = $pdo->lastInsertId();

        decrementStock();

        session_start();
        $_SESSION['order'] = ['id' => $orderId, 'name' => $name, 'size' => $size];

        header('Location: ' . MP_PAYMENT_LINK);
        exit;
    }
}

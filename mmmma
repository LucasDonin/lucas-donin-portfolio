function refreshStock() {
    fetch('api_stock.php?_=' + Date.now())
        .then(r => r.json())
        .then(data => {
            const el   = document.getElementById('stockCount');
            const bar  = document.querySelector('.stock-bar-fill');
            const text = document.getElementById('stockText');
            if (el)   { el.textContent = data.stock; el.classList.toggle('low', data.low || data.sold_out); }
            if (bar)  { bar.style.width = data.percent + '%'; bar.classList.toggle('low', data.low || data.sold_out); }
            if (text) {
                text.textContent = data.sold_out ? '⚠️ Estoque esgotado'
                    : data.low ? '🔥 Últimas unidades! Corre.'
                    : 'Restam ' + data.stock + ' de <?= STOCK_TOTAL ?> unidades';
            }
        })
        .catch(() => {});
}
setInterval(refreshStock, 30000);

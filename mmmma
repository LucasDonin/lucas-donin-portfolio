require_once __DIR__ . '/config.php';

function getDB(): PDO {
    $dir = dirname(DB_PATH);
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $pdo = new PDO('sqlite:' . DB_PATH);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $pdo->exec("PRAGMA journal_mode=WAL");

    // Tabela de pedidos
    $pdo->exec("CREATE TABLE IF NOT EXISTS orders (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT NOT NULL,
        phone TEXT NOT NULL,
        size TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'pending',
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        confirmed_at DATETIME,
        notes TEXT
    )");

    // Tabela de estoque (linha única)
    $pdo->exec("CREATE TABLE IF NOT EXISTS stock (
        id INTEGER PRIMARY KEY DEFAULT 1,
        available INTEGER NOT NULL DEFAULT " . STOCK_START . "
    )");

    // Inicia estoque se não existir
    $pdo->exec("INSERT OR IGNORE INTO stock (id, available) VALUES (1, " . STOCK_START . ")");

    return $pdo;
}

function getStock(): int {
    $pdo = getDB();
    $stmt = $pdo->query("SELECT available FROM stock WHERE id = 1");
    return (int)($stmt->fetchColumn() ?? 0);
}

function decrementStock(): bool {
    $pdo = getDB();
    $stock = getStock();
    if ($stock <= 0) return false;
    $pdo->exec("UPDATE stock SET available = available - 1 WHERE id = 1 AND available > 0");
    return true;
}

function incrementStock(): bool {
    $pdo = getDB();
    $pdo->exec("UPDATE stock SET available = MIN(available + 1, " . STOCK_TOTAL . ") WHERE id = 1");
    return true;
}

